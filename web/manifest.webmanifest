{
  "name": "Watchlog",
  "short_name": "Watchlog",
  "description": "Suivi de séries et de films, épisode par épisode.",
  "lang": "fr",
  "start_url": "./#/accueil",
  "scope": "./",
  "display": "standalone",
  "background_color": "#14181d",
  "theme_color": "#2f5d8a",
  "icons": [
    {
      "src": "assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
